# /etc/systemd/system/qmx-remote.service
#
# Runs the server as the unprivileged user "qmx" (groups dialout + audio
# for the radio's serial port and sound card). Before the start, as root
# ("+"): setup network stored, wifi.txt from the boot partition imported.

[Unit]
Description=QMX-REMOTE (browser remote for QRP Labs QMX / QMX+)
After=network.target NetworkManager.service sound.target
Wants=NetworkManager.service

[Service]
Type=simple
User=qmx
Group=qmx
SupplementaryGroups=dialout audio
WorkingDirectory=/opt/qmx-remote
Environment=NODE_ENV=production
Environment=QMX_DATA=/var/lib/qmx-remote
Environment=PORT=80
ExecStartPre=+/usr/bin/node /opt/qmx-remote/dist/cli/wifi-import.js
ExecStart=/usr/bin/node /opt/qmx-remote/dist/index.js
AmbientCapabilities=CAP_NET_BIND_SERVICE
StateDirectory=qmx-remote
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
