# /etc/systemd/system/qmx-remote-boot.service
#
# At every boot, before the server (scripts/boot.sh): USB full speed on
# the Pi Zero, swap with little RAM, Wi-Fi country, service access via
# qmx-access.txt on the boot partition.

[Unit]
Description=QMX-REMOTE boot checks (USB, swap, Wi-Fi country, service access)
After=local-fs.target
Before=qmx-remote.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/qmx-remote/scripts/boot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
